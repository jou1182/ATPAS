# ══════════════════════════════════════════
# ATPAS — .gitignore
# ══════════════════════════════════════════

# ── Python cache ────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.eggs/

# ── Test cache ───────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── PyInstaller build output ─────────────
dist/
build/
*.spec.bak

# ── Output directory (generated files) ───
# Never commit generated proposals or audit logs
output/**
!output/.gitkeep

# ── Sensitive data files ─────────────────
# Passwords
كلمة السر الافتراضية.txt

# Real client / owner data
_owners_real.json
_owner_extract.json

# ── Personal documents (not code) ────────
*.xlsx
*.xls

# ── Source documents (content library)
# Add real content files locally — never commit client/client-like content
templates/source_documents/*
!templates/source_documents/.gitkeep

# ── Spec-kit internal ────────────────────
.specify/

# ── IDE / OS ─────────────────────────────
.vscode/
.idea/
.claude/
.atpas_welcomed
.atpas_sessions.json
build_history.json
*.swp
*.swo
Thumbs.db
Desktop.ini
.DS_Store

# ── Environment ──────────────────────────
.env
.env.*
*.env
venv/
.venv/
env/

# ── Logs ─────────────────────────────────
*.log

# أداة المطوّر — لا تُوزَّع
tools/generate_license.py

# PyArmor obfuscation temp
.obf/
pyarmor_runtime_000000/
*.bak

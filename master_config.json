  "ui_config": {
    "window_title": "Al-Rawaf Proposal Builder v1.0",
    "window_width": 1200,
    "window_height": 800,
    "theme": "light",
    "language": "ar",
    "default_project": "wastewater",
    "default_owner": "nwc",
    "show_tips": true,
    "auto_save": true,
    "auto_save_interval_seconds": 300
  },
  "paths": {
    "base_directory": "./al_rawaf_proposal_system",
    "config_directory": "config",
    "metadata_directory": "metadata",
    "templates_directory": "templates",
    "source_documents": "templates/source_documents",
    "extracted_sections": "templates/extracted_sections",
    "output_directory": "output",
    "logs_directory": "output/logs",
    "audit_directory": "output/audit_trail",
    "reports_directory": "output/reports"
  },
  "logging": {
    "enabled": true,
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "file_rotation": "daily",
    "retention_days": 30
  },
  "validation": {
    "strict_mode": true,
    "check_dependencies": true,
    "check_sequence": true,
    "check_mandatory_sections": true,
    "allow_warnings": true,
    "allow_deprecated_codes": false
  },
  "performance": {
    "max_codes_per_proposal": 300,
    "max_file_size_mb": 500,
    "processing_timeout_seconds": 300,
    "image_quality": "high",
    "image_dpi": 300
  },
  "security": {
    "encryption_enabled": true,
    "encryption_algorithm": "AES-256",
    "audit_trail_enabled": true,
    "backup_enabled": true,
    "backup_location": "backups"
  },
  "version_info": {
    "schema_version": "1.0",
    "last_schema_update": "2026-04-20",
    "compatible_versions": [
      "1.0.0",
      "1.0.1"
    ],
    "minimum_python_version": "3.9",
    "required_libraries": [
      "python-docx>=0.8.11",
      "Pillow>=9.0.0",
      "openpyxl>=3.7.0"
    ]
  }

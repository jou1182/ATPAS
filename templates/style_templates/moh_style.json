  },

  "footer": {
    "enabled": true,
    "text_ar": "وزارة الإسكان - سري",
    "show_page_number": true,
    "page_format": "صفحة {n} من {total}",
    "line_above": true
  },

  "compliance_matrix": {
    "enabled": true,
    "title_ar": "مصفوفة الامتثال",
    "position": "appendix"
  },

  "detailed_reporting": true,
  "page_numbering": true,
  "table_of_contents": true,
  "rtl_direction": true,
  "language": "ar"

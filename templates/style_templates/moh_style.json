{
  "style_id": "moh",
  "owner": "Ministry of Housing",
  "scheme": "gray_red",

  "fonts": {
    "body": { "family": "Times New Roman", "size": 12, "bold": false },
    "heading1": { "family": "Times New Roman", "size": 16, "bold": true },
    "heading2": { "family": "Times New Roman", "size": 14, "bold": true },
    "heading3": { "family": "Times New Roman", "size": 13, "bold": true },
    "caption": { "family": "Times New Roman", "size": 10, "bold": false, "italic": true }
  },

  "colors": {
    "primary": "#8B0000",
    "secondary": "#808080",
    "accent": "#A52A2A",

{
  "style_id": "nwc",
  "owner": "National Water Company",
  "scheme": "blue_white",

  "fonts": {
    "body": { "family": "Tajawal", "size": 12, "bold": false },
    "heading1": { "family": "Tajawal", "size": 16, "bold": true },
    "heading2": { "family": "Tajawal", "size": 14, "bold": true },
    "heading3": { "family": "Tajawal", "size": 13, "bold": true },
